<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <VsixType>v3</VsixType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <NoWarn>NU1701</NoWarn>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VisualStudioVersion>17.0</VisualStudioVersion>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <UseCodebase>true</UseCodebase>
    <DeployVSTemplates>false</DeployVSTemplates>
    <TemplateOutputDirectory>$(BaseIntermediateOutputPath)vsix-templates\</TemplateOutputDirectory>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <TargetVsixContainer>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).vsix</TargetVsixContainer>
    <BuildDependsOn>$(BuildDependsOn);GeneratePkgDef;CreateVsixContainer</BuildDependsOn>
    <CreateVsixContainerDependsOn>$(CreateVsixContainerDependsOn);GeneratePkgDef</CreateVsixContainerDependsOn>
    <RootNamespace>Copperfin.VisualStudio</RootNamespace>
    <AssemblyName>Copperfin.VisualStudio</AssemblyName>
    <DefineConstants>$(DefineConstants);COPPERFIN_VISUAL_STUDIO</DefineConstants>
    <RespectAlreadyAssignedItemCulture>true</RespectAlreadyAssignedItemCulture>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="Runtime" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Copperfin.Studio\CopperfinDocumentPathIdentity.cs" Link="Shared\CopperfinDocumentPathIdentity.cs" />
    <Compile Include="..\Copperfin.Studio\StudioTerminalWindowControl.cs" Link="Shared\StudioTerminalWindowControl.cs" />
    <VSCTCompile Include="Copperfin.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <EmbeddedResource Update="CommandResources.resx">
      <WithCulture>false</WithCulture>
      <ManifestResourceName>CopperfinCommandResources</ManifestResourceName>
      <MergeWithCTO>true</MergeWithCTO>
      <GenerateSource>false</GenerateSource>
    </EmbeddedResource>
    <EmbeddedResource Update="CommandResources.es.resx">
      <Culture>es</Culture>
      <WithCulture>true</WithCulture>
      <ManifestResourceName>CopperfinCommandResources.es</ManifestResourceName>
      <MergeWithCTO>true</MergeWithCTO>
      <GenerateSource>false</GenerateSource>
    </EmbeddedResource>
    <EmbeddedResource Update="CommandResources.pt.resx">
      <Culture>pt</Culture>
      <WithCulture>true</WithCulture>
      <ManifestResourceName>CopperfinCommandResources.pt</ManifestResourceName>
      <MergeWithCTO>true</MergeWithCTO>
      <GenerateSource>false</GenerateSource>
    </EmbeddedResource>
    <EmbeddedResource Update="CommandResources.qps-ploc.resx">
      <Culture>qps-ploc</Culture>
      <WithCulture>true</WithCulture>
      <ManifestResourceName>CopperfinCommandResources.qps-ploc</ManifestResourceName>
      <MergeWithCTO>true</MergeWithCTO>
      <GenerateSource>false</GenerateSource>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="es\Extension.vsixlangpack">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>es</VSIXSubPath>
    </Content>
    <Content Include="pt\Extension.vsixlangpack">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>pt</VSIXSubPath>
    </Content>
    <Content Include="qps-ploc\Extension.vsixlangpack">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>qps-ploc</VSIXSubPath>
    </Content>
  </ItemGroup>

  <Target Name="PackageVsixAfterBuild"
          AfterTargets="Build"
          Condition="'$(CreateVsixContainer)' == 'true'">
    <CallTarget Targets="GeneratePkgDef;CreateVsixContainer" />
  </Target>

  <Import Project="$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2120\tools\vssdk\Microsoft.VsSDK.targets"
          Condition="Exists('$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2120\tools\vssdk\Microsoft.VsSDK.targets')" />

  <ItemGroup>
    <_CopperfinVsctCulture Include="en-US">
      <Language>en-US</Language>
      <OutputFile>Copperfin.cto</OutputFile>
    </_CopperfinVsctCulture>
    <_CopperfinVsctCulture Include="es">
      <Language>es-419</Language>
      <OutputFile>Copperfin.es.cto</OutputFile>
    </_CopperfinVsctCulture>
    <_CopperfinVsctCulture Include="pt">
      <Language>pt-BR</Language>
      <OutputFile>Copperfin.pt.cto</OutputFile>
    </_CopperfinVsctCulture>
    <_CopperfinVsctCulture Include="qps-ploc">
      <Language>qps-ploc</Language>
      <OutputFile>Copperfin.qps-ploc.cto</OutputFile>
    </_CopperfinVsctCulture>
  </ItemGroup>

  <Target Name="CompileLocalizedCopperfinVsct"
          BeforeTargets="GenerateListOfCTO"
          DependsOnTargets="VSCTCompile"
          Condition="'$(BuildingProject)' != 'false' And '@(VSCTCompile)' != ''">
    <VSCTCompiler AdditionalIncludeDirectories="@(_InternalVSCTIncludePath)"
                  IntermediateDirectory="$(IntermediateOutputPath)"
                  Definitions="$(__internal_VSCTDefinitions)"
                  NoLogo="true"
                  OutputFile="%(_CopperfinVsctCulture.OutputFile)"
                  Source="$(MSBuildProjectDirectory)\Copperfin.vsct"
                  Culture="%(_CopperfinVsctCulture.Language)"
                  Verbose="$(VsctVerboseOutput)">
      <Output TaskParameter="TemporaryFiles" ItemName="_CopperfinLocalizedVsctTemporaryFiles" />
    </VSCTCompiler>
    <ItemGroup>
      <_GeneratedCTOFiles Include="$(IntermediateOutputPath)Copperfin.es.cto" />
      <_GeneratedCTOFiles Include="$(IntermediateOutputPath)Copperfin.pt.cto" />
      <_GeneratedCTOFiles Include="$(IntermediateOutputPath)Copperfin.qps-ploc.cto" />
      <FileWrites Include="@(_CopperfinVsctCulture->'$(IntermediateOutputPath)%(OutputFile)')" />
      <FileWrites Include="@(_CopperfinLocalizedVsctTemporaryFiles)" />
    </ItemGroup>
  </Target>
</Project>
