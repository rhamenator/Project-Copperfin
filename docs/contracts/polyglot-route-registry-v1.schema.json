{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-copperfin.dev/contracts/polyglot-route-registry-v1.schema.json",
  "title": "Copperfin Polyglot Route Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "routes"],
  "properties": {
    "registry_version": {"const": "1.0"},
    "routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "state"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "state": {
          "type": "string",
          "enum": ["off", "shadow", "canary", "on", "retire-legacy"]
        },
        "canary_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
