cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED INSTALL_ROOT OR "${INSTALL_ROOT}" STREQUAL "")
    message(FATAL_ERROR "INSTALL_ROOT is required")
endif()
if(NOT DEFINED SOURCE_DIR OR "${SOURCE_DIR}" STREQUAL "")
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()

set(locale_install_root "${INSTALL_ROOT}/share/copperfin/locales")
set(inventory_path "${locale_install_root}/inventory.txt")
if(NOT EXISTS "${inventory_path}" OR IS_DIRECTORY "${inventory_path}" OR IS_SYMLINK "${inventory_path}")
    message(FATAL_ERROR "Installed locale inventory is missing or not a regular file: ${inventory_path}")
endif()
set(source_inventory "${SOURCE_DIR}/resources/locales/inventory.txt")
if(NOT EXISTS "${source_inventory}")
    message(FATAL_ERROR "Source locale inventory is missing: ${source_inventory}")
endif()
file(SHA256 "${source_inventory}" source_inventory_hash)
file(SHA256 "${inventory_path}" installed_inventory_hash)
if(NOT source_inventory_hash STREQUAL installed_inventory_hash)
    message(FATAL_ERROR "Installed locale inventory differs from source")
endif()
file(STRINGS "${inventory_path}" inventory_lines)
list(POP_FRONT inventory_lines version_line)
if(NOT version_line STREQUAL "version 1")
    message(FATAL_ERROR "Unsupported locale inventory version: ${inventory_path}")
endif()

set(declared_locales "")
set(source_count 0)
set(pseudo_count 0)
foreach(line IN LISTS inventory_lines)
    if(NOT line MATCHES "^[a-z][A-Za-z0-9-]* (source|unreviewed|pseudo|overlay)( [a-z][A-Za-z0-9-]*)?$")
        message(FATAL_ERROR "Malformed locale inventory entry: ${line}")
    endif()
    string(REPLACE " " ";" fields "${line}")
    list(LENGTH fields field_count)
    list(GET fields 0 locale)
    list(GET fields 1 role)
    if(role STREQUAL "overlay")
        if(NOT field_count EQUAL 3)
            message(FATAL_ERROR "Overlay locale requires a parent: ${locale}")
        endif()
        list(GET fields 2 parent)
        if(parent STREQUAL locale OR parent STREQUAL "en-US" OR
                parent STREQUAL "qps-ploc" OR NOT parent IN_LIST declared_locales)
            message(FATAL_ERROR "Overlay parent is not declared before locale: ${locale}")
        endif()
        list(FIND overlay_locales "${parent}" parent_overlay_index)
        string(FIND "${locale}" "${parent}-" parent_prefix_index)
        if(NOT parent_overlay_index EQUAL -1 OR NOT parent_prefix_index EQUAL 0 OR
                parent MATCHES "-[A-Za-z0-9]$")
            message(FATAL_ERROR "Overlay parent must be a full runtime fallback ancestor: ${locale}")
        endif()
    elseif(NOT field_count EQUAL 2)
        message(FATAL_ERROR "Unexpected locale inventory field: ${locale}")
    endif()
    if(locale MATCHES "--|-$" OR locale IN_LIST declared_locales)
        message(FATAL_ERROR "Invalid or duplicate locale inventory entry: ${locale}")
    endif()
    if(role STREQUAL "source")
        if(NOT locale STREQUAL "en-US")
            message(FATAL_ERROR "Only en-US may be the source locale")
        endif()
        math(EXPR source_count "${source_count}+1")
    elseif(role STREQUAL "pseudo")
        if(NOT locale STREQUAL "qps-ploc")
            message(FATAL_ERROR "Only qps-ploc may be a pseudo locale")
        endif()
        math(EXPR pseudo_count "${pseudo_count}+1")
    endif()
    if(role STREQUAL "overlay")
        list(APPEND overlay_locales "${locale}")
    endif()
    list(APPEND declared_locales "${locale}")
    set(catalog_path "${locale_install_root}/${locale}/strings.json")
    if(NOT EXISTS "${catalog_path}" OR IS_DIRECTORY "${catalog_path}" OR IS_SYMLINK "${catalog_path}")
        message(FATAL_ERROR "Installed locale catalog is missing or not a regular file: ${catalog_path}")
    endif()
    file(GLOB locale_children RELATIVE "${locale_install_root}/${locale}"
        "${locale_install_root}/${locale}/*"
        "${locale_install_root}/${locale}/.*")
    list(REMOVE_ITEM locale_children "." "..")
    foreach(child IN LISTS locale_children)
        if(NOT child STREQUAL "strings.json")
            message(FATAL_ERROR "Undeclared installed locale content: ${locale}/${child}")
        endif()
    endforeach()
    file(SIZE "${catalog_path}" catalog_size)
    if(catalog_size LESS_EQUAL 0)
        message(FATAL_ERROR "Installed locale catalog is empty: ${catalog_path}")
    endif()
    set(source_catalog "${SOURCE_DIR}/resources/locales/${locale}/strings.json")
    if(NOT EXISTS "${source_catalog}")
        message(FATAL_ERROR "Declared source catalog is missing: ${source_catalog}")
    endif()
    file(SHA256 "${source_catalog}" source_hash)
    file(SHA256 "${catalog_path}" installed_hash)
    if(NOT source_hash STREQUAL installed_hash)
        message(FATAL_ERROR "Installed catalog differs from source: ${locale}")
    endif()
endforeach()
if(NOT source_count EQUAL 1 OR NOT pseudo_count EQUAL 1)
    message(FATAL_ERROR "Locale inventory requires one en-US source and one qps-ploc pseudo catalog")
endif()

file(GLOB installed_children RELATIVE "${locale_install_root}"
    "${locale_install_root}/*" "${locale_install_root}/.*")
list(REMOVE_ITEM installed_children "." "..")
foreach(child IN LISTS installed_children)
    if(child STREQUAL "inventory.txt")
        continue()
    endif()
    if(NOT child IN_LIST declared_locales OR NOT IS_DIRECTORY "${locale_install_root}/${child}" OR
       IS_SYMLINK "${locale_install_root}/${child}")
        message(FATAL_ERROR "Undeclared or malformed installed locale: ${child}")
    endif()
endforeach()
message(STATUS "Installed locale catalog contract passed: ${declared_locales}")
