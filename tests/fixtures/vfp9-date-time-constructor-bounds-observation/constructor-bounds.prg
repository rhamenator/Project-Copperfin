            ? aCases[nCase,1] + " => D:[" + DTOC(uValue, 1) + "] EMPTY=" + TRANSFORM(EMPTY(uValue))
        ELSE
            ? aCases[nCase,1] + " => T:[" + TTOC(uValue, 1) + "] EMPTY=" + TRANSFORM(EMPTY(uValue))
        ENDIF
    CATCH TO oError
        ? aCases[nCase,1] + " => ERR " + TRANSFORM(oError.ErrorNo) + " :" + oError.Message
    ENDTRY
ENDFOR
