LOCAL lcCommand, loError, nIndex, nCount, lcCommands, lcStatus
LOCAL ARRAY aCommands[1]
SET TALK OFF
SET DATE TO MDY
? 'VERSION|' + VERSION()
? 'CLOCK|' + TRANSFORM(YEAR(DATE()))
? 'DEFAULT|' + SET('CENTURY') + '|' + TRANSFORM(SET('CENTURY',1)) + '|' + TRANSFORM(SET('CENTURY',2)) + '|' + TRANSFORM(SET('CENTURY',3))
TEXT TO lcCommands NOSHOW
SET CENTURY OFF
SET CENTURY TO 19 ROLLOVER 75
SET CENTURY ON
SET CENTURY TO 20
SET CENTURY TO
SET CENTURY TO 1 ROLLOVER 0
SET CENTURY TO 99 ROLLOVER 99
SET CENTURY TO 19.9 ROLLOVER 74.9
SET CENTURY TO 0
SET CENTURY TO 100
SET CENTURY TO -1
SET CENTURY TO 1E300
SET CENTURY TO (1E300 * 1E300)
SET CENTURY TO 20 ROLLOVER -1
SET CENTURY TO 20 ROLLOVER 100
SET CENTURY TO 20 ROLLOVER 1E300
SET CENTURY TO 19 ROLLOVER (1E300 * 1E300)
SET CENTURY TO 19 ROLLOVER 4294967321
SET CENTURY TO 19 ROLLOVER -4294967271
SET CENTURY TO 4294967315 ROLLOVER 25
SET CENTURY TO 0.9 ROLLOVER 0
SET CENTURY TO 99.9 ROLLOVER 99.9
SET CENTURY TO '19' ROLLOVER 50
SET CENTURY TO .T. ROLLOVER 50
SET CENTURY TO .NULL. ROLLOVER 50
SET CENTURY TO $19.9000 ROLLOVER $74.9000
SET CENTURY TO 19 ROLLOVER '50'
SET CENTURY TO 19 ROLLOVER .T.
SET CENTURY TO 19 ROLLOVER .NULL.
SET CENTURY TO 19 ROLLOVER
SET CENTURY TO ROLLOVER 50
SET CENTURY
SET CENTURY BAD
ENDTEXT
nCount = ALINES(aCommands, lcCommands, 1)
FOR nIndex = 1 TO nCount
    SET CENTURY OFF
    SET CENTURY TO 19 ROLLOVER 75
    lcCommand = aCommands[nIndex]
    lcStatus = 'OK'
    TRY
        &lcCommand
    CATCH TO loError
        lcStatus = 'ERR:' + TRANSFORM(loError.ErrorNo)
    ENDTRY
    ? 'COMMAND|' + lcCommand + '|' + lcStatus + '|' + SET('CENTURY') + '|' + TRANSFORM(SET('CENTURY',1)) + '|' + TRANSFORM(SET('CENTURY',2)) + '|' + TRANSFORM(SET('CENTURY',3)) + '|' + TRANSFORM(YEAR(CTOD('01/02/74'))) + '|' + TRANSFORM(YEAR(CTOD('01/02/75')))
ENDFOR
SET CENTURY TO 20 ROLLOVER 25
FOR nIndex = -1 TO 5
    lcStatus = 'OK'
    TRY
        lcStatus = VARTYPE(SET('CENTURY',nIndex)) + ':' + TRANSFORM(SET('CENTURY',nIndex))
    CATCH TO loError
        lcStatus = 'ERR:' + TRANSFORM(loError.ErrorNo)
    ENDTRY
    ? 'QUERY|' + TRANSFORM(nIndex) + '|' + lcStatus
ENDFOR
LOCAL loSession, nOriginalSession
nOriginalSession = SET('DATASESSION')
loSession = CREATEOBJECT('Session')
SET DATASESSION TO (loSession.DataSessionID)
? 'SESSION|FRESH|' + SET('CENTURY') + '|' + TRANSFORM(SET('CENTURY',1)) + '|' + TRANSFORM(SET('CENTURY',2)) + '|' + TRANSFORM(SET('CENTURY',3))
SET CENTURY ON
SET CENTURY TO 18 ROLLOVER 25
? 'SESSION|CHANGED|' + SET('CENTURY') + '|' + TRANSFORM(SET('CENTURY',1)) + '|' + TRANSFORM(SET('CENTURY',2))
SET DATASESSION TO (nOriginalSession)
? 'SESSION|RESTORED|' + SET('CENTURY') + '|' + TRANSFORM(SET('CENTURY',1)) + '|' + TRANSFORM(SET('CENTURY',2))
loSession = .NULL.
