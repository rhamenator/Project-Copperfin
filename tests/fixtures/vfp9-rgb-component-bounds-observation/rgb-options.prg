FOR nCase = 1 TO ALEN(aCases, 1)
    TRY
        uResult = EVALUATE(aCases[nCase,2])
        ? aCases[nCase,1] + " => N:[" + TRANSFORM(uResult) + "]"
    CATCH TO oError
        ? aCases[nCase,1] + " => ERR " + TRANSFORM(oError.ErrorNo) + " :" + oError.Message
    ENDTRY
ENDFOR
