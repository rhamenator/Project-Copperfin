FUNCTION HexBytes
 LPARAMETERS value
 LOCAL result,position,byte,digits
 result=''
 digits='0123456789ABCDEF'
 FOR position=1 TO LEN(value)
  byte=ASC(SUBSTR(value,position,1))
  result=result+SUBSTR(digits,INT(byte/16)+1,1)+SUBSTR(digits,MOD(byte,16)+1,1)
 ENDFOR
 RETURN result
ENDFUNC

